generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Currency {
  EUR
  ILS
  USD
}

enum InvoiceStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum CommissionType {
  PERCENT
  FIXED
}

// Statut d'un prospect du stock marketplace
enum ProspectStatus {
  AVAILABLE
  SOLD
}

// --- Inbound (API de réception de leads + facturation pay-per-lead) ---

// Mode de paiement d'un client : AUTO = prélèvement carte (Stripe charge_automatically),
// INVOICE = facture envoyée à régler (Stripe send_invoice).
enum PaymentMode {
  AUTO
  INVOICE
}

// Formule de facturation d'un client pour les leads reçus via l'API.
// MONTHLY = facture agrégée en fin de mois. PREPAID = solde en € payé d'avance, décompté par lead.
enum BillingMode {
  MONTHLY
  PREPAID
}

// Statut d'un rechargement de solde prépayé.
enum TopupStatus {
  PENDING // facture Stripe émise, en attente de paiement
  PAID    // payé → solde crédité
  FAILED  // paiement échoué
  MANUAL  // ajusté à la main par un admin (crédité immédiatement)
}

// Statut d'un lead reçu via l'API. Seuls les VALID sont facturés.
enum LeadStatus {
  VALID
  DUPLICATE
  REJECTED
}

// Statut d'une facture mensuelle agrégée.
enum MonthlyInvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
}

// Département métier d'un site (regroupement thématique pour s'y retrouver).
enum Department {
  VOYAGES
  EVENTS
  BTP
  BOUTIQUE
  AUTRE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   @db.Text
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  archived      Boolean   @default(false)

  accounts   Account[]
  sessions   Session[]
  brands     Brand[]
  clients    Client[]
  apporteurs Apporteur[]
  leads      Lead[]
  invoices   Invoice[]
  themes     Theme[]
  prospects  Prospect[]
}

// --- Tables NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tables métier ---

model Brand {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leads             Lead[]
  invoices          Invoice[]
  purchasedProspects Prospect[] @relation("BrandPurchasedProspects")

  @@index([userId])
}

model Client {
  id               String      @id @default(cuid())
  name             String
  // Raison sociale et numéro SIRET (facturation / identification de l'entreprise cliente)
  companyName      String?
  siret            String?
  email            String?
  phone            String?
  // E-mails (séparés par , ; ou retour ligne) où sont transférés les leads par défaut, pour tous ses sites
  notifyEmails     String?     @db.Text
  stripeCustomerId String?
  // Mode de facturation pay-per-lead : AUTO (prélèvement carte) ou INVOICE (facture à régler)
  paymentMode      PaymentMode @default(AUTO)
  // Formule : MONTHLY (facture mensuelle) ou PREPAID (solde en € payé d'avance)
  billingMode      BillingMode @default(MONTHLY)
  // Solde prépayé en € (formule PREPAID) : décompté du prix du site à chaque lead livré.
  prepaidBalance   Float       @default(0)
  // Le client a-t-il déjà été prévenu que son solde est épuisé ? (évite de renvoyer le mail à chaque lead)
  prepaidDepletedNotified Boolean @default(false)
  // Mot de passe du portail client (haché bcrypt). null = pas encore défini (première connexion à faire).
  portalPassword   String?     @db.Text
  archived         Boolean     @default(false)
  createdAt        DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  apporteurId String?
  apporteur   Apporteur? @relation(fields: [apporteurId], references: [id])

  leads           Lead[]
  invoices        Invoice[]
  campagnes       Campagne[]
  monthlyInvoices MonthlyInvoice[]
  topups          PrepaidTopup[]
  loginTokens     ClientLoginToken[]

  @@index([userId])
  @@index([apporteurId])
}

// Jeton de connexion "lien magique" du portail client : usage unique, courte durée.
model ClientLoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Rechargement de solde prépayé d'un client (achat d'un « pack » de leads).
// amount = montant en € crédité au solde. Payé via Stripe (PENDING → PAID au webhook) ou ajusté à la main (MANUAL).
model PrepaidTopup {
  id              String      @id @default(cuid())
  amount          Float
  currency        Currency    @default(EUR)
  status          TopupStatus @default(PENDING)
  stripeInvoiceId String?
  note            String?
  createdAt       DateTime    @default(now())
  paidAt          DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([stripeInvoiceId])
}

model Apporteur {
  id              String         @id @default(cuid())
  name            String
  email           String?
  phone           String?
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(10)
  archived        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clients     Client[]
  commissions Commission[]
  invoices    Invoice[]

  @@index([userId])
}

model Lead {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  buyPrice     Float
  buyCurrency  Currency @default(EUR)
  sellPrice    Float
  sellCurrency Currency @default(EUR)
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([brandId])
  @@index([clientId])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  amount          Float
  currency        Currency      @default(EUR)
  status          InvoiceStatus @default(PENDING)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  stripeInvoiceId String?
  archived        Boolean       @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Parties de la facture. Mr.Lead = type "MRLEAD" (interne, pas de FK).
  // Le débiteur doit, le créditeur reçoit. Chaque côté ∈ CLIENT | BRAND | APPORTEUR | MRLEAD.
  debtorType   String @default("CLIENT")
  creditorType String @default("MRLEAD")

  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id])
  apporteurId String?
  apporteur   Apporteur? @relation(fields: [apporteurId], references: [id])

  payments Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([brandId])
  @@index([apporteurId])
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  currency        Currency @default(EUR)
  method          String?
  stripePaymentId String?
  paidAt          DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Commission {
  id       String    @id @default(cuid())
  amount   Float
  currency Currency  @default(EUR)
  status   String    @default("PENDING")
  paidAt   DateTime?

  apporteurId String
  apporteur   Apporteur @relation(fields: [apporteurId], references: [id])

  @@index([apporteurId])
}

// --- Marketplace de leads ---

// Un thème = une catégorie de leads vendue aux brands (ex: "Voyage cacher").
// Prix de base par lead + paliers de remise quantité (PriceTier).
model Theme {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  pricePerLead Float
  currency     Currency @default(EUR)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Champs personnalisés du thème : [{ key, label, type: "text"|"number" }]
  fields Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tiers     PriceTier[]
  prospects Prospect[]

  @@index([userId])
}

// Palier de remise : à partir de `minQty` leads achetés, le prix unitaire passe à `pricePerLead`.
model PriceTier {
  id           String @id @default(cuid())
  minQty       Int
  pricePerLead Float

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

// Un prospect du stock : contact + champ libre "détails", rattaché à un thème.
// Exclusif : une fois vendu (status SOLD), il est attribué à une brand acheteuse et sort du stock.
model Prospect {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  details   String?        @db.Text
  // Valeurs des champs personnalisés du thème : { [key]: string }
  data      Json?
  source    String?
  status    ProspectStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  soldAt    DateTime?

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  buyerBrandId String?
  buyerBrand   Brand?  @relation("BrandPurchasedProspects", fields: [buyerBrandId], references: [id])

  @@index([themeId])
  @@index([userId])
  @@index([buyerBrandId])
  @@index([status])
}

// --- Inbound : dossiers, leads reçus, factures mensuelles ---

// Une campagne = un regroupement de sites d'un client (ex: "Voyages").
// Un client peut avoir plusieurs campagnes ; une campagne contient plusieurs sites.
model Campagne {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sites Dossier[]

  @@index([clientId])
}

// Un "Site" (modèle Dossier) = une source/un site d'une campagne, avec son token API et son prix unitaire.
// C'est lui qui reçoit les leads via l'API.
model Dossier {
  id        String   @id @default(cuid())
  name      String
  token     String   @unique // 'ml_' + 32 hex, identifie le site dans l'URL de l'API
  unitPrice Float    @default(0)
  active    Boolean  @default(true)
  // Mode "attribué à JBoost" : quand activé, chaque NOUVEAU lead reçu est automatiquement
  // affecté à JBoost (rappelé par JBoost, exclu de la facture du client). N'affecte pas les leads déjà reçus.
  autoAssignJboost Boolean @default(false)
  // Département métier du site (regroupement pour s'y retrouver)
  department Department @default(AUTRE)
  // Termes du contrat (texte libre, éditable) propres à ce site
  contractTerms String? @db.Text
  // Lien du site (URL publique), cliquable depuis la page du site
  websiteUrl    String?
  // Destinataires e-mail (séparés par , ; ou retour ligne) à qui transférer chaque lead reçu
  notifyEmails  String? @db.Text
  createdAt DateTime @default(now())

  campagneId String
  campagne   Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  leads  InboundLead[]
  offers Offer[]

  @@index([campagneId])
  @@index([token])
}

// Une offre (= un "contrat") proposée sur un site. Un site peut en avoir plusieurs.
// Quand un lead affecté à JBoost accepte, on enregistre l'offre qu'il a choisie.
model Offer {
  id              String         @id @default(cuid())
  name            String
  commissionType  CommissionType @default(PERCENT) // PERCENT (%) ou FIXED (€)
  commissionValue Float          @default(0)
  sellPrice       Float          @default(0)
  deposit         Float? // acompte, optionnel
  createdAt       DateTime       @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Un lead peut choisir plusieurs offres (rare mais possible) → relation N-N.
  chosenByLeads InboundLead[] @relation("LeadChosenOffers")

  @@index([dossierId])
}

// Un lead reçu via l'API, rattaché à un dossier. Statut auto (VALID/DUPLICATE) ou manuel (REJECTED).
model InboundLead {
  id         String     @id @default(cuid())
  name       String?
  email      String?
  phone      String?
  message    String?    @db.Text
  source     String?
  // Champs supplémentaires envoyés par le formulaire (destination, dates, compagnie…) : { [clé]: valeur }
  extra      Json?
  status     LeadStatus @default(VALID)
  ip         String?
  // Affecté à JBoost = c'est NOUS qui rappelons ce lead → exclu de la facture du client
  assignedToJboost Boolean @default(false)
  // Le lead a-t-il bien été transmis au client par e-mail ? false = retenu (client suspendu au moment
  // de la réception) → sera renvoyé automatiquement dès que le client régularise sa facture.
  forwardedToClient Boolean @default(false)
  receivedAt DateTime   @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Offres choisies par le lead (il peut en prendre plusieurs). Vide = pas encore pris.
  chosenOffers Offer[] @relation("LeadChosenOffers")

  // Facture mensuelle où ce lead a été comptabilisé (évite la double facturation).
  monthlyInvoiceId String?
  monthlyInvoice   MonthlyInvoice? @relation(fields: [monthlyInvoiceId], references: [id])

  @@index([dossierId, status])
  @@index([receivedAt])
  @@index([monthlyInvoiceId])
  @@index([assignedToJboost])
  @@index([forwardedToClient])
}

// Facture mensuelle agrégée d'un client (pay-per-lead). Une seule par client et par période.
model MonthlyInvoice {
  id              String               @id @default(cuid())
  period          String               // format "AAAA-MM"
  leadCount       Int                  @default(0)
  amount          Float                @default(0)
  currency        Currency             @default(EUR)
  stripeInvoiceId String?
  status          MonthlyInvoiceStatus @default(DRAFT)
  createdAt       DateTime             @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  leads InboundLead[]

  @@unique([clientId, period])
  @@index([clientId])
}
