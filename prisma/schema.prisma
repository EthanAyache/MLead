generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Currency {
  EUR
  ILS
  USD
}

enum InvoiceStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum CommissionType {
  PERCENT
  FIXED
}

// Statut d'un prospect du stock marketplace
enum ProspectStatus {
  AVAILABLE
  SOLD
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   @db.Text
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  archived      Boolean   @default(false)

  accounts   Account[]
  sessions   Session[]
  brands     Brand[]
  clients    Client[]
  apporteurs Apporteur[]
  leads      Lead[]
  invoices   Invoice[]
  themes     Theme[]
  prospects  Prospect[]
}

// --- Tables NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tables métier ---

model Brand {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leads             Lead[]
  invoices          Invoice[]
  purchasedProspects Prospect[] @relation("BrandPurchasedProspects")

  @@index([userId])
}

model Client {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  stripeCustomerId String?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  apporteurId String?
  apporteur   Apporteur? @relation(fields: [apporteurId], references: [id])

  leads    Lead[]
  invoices Invoice[]

  @@index([userId])
  @@index([apporteurId])
}

model Apporteur {
  id              String         @id @default(cuid())
  name            String
  email           String?
  phone           String?
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(10)
  archived        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clients     Client[]
  commissions Commission[]
  invoices    Invoice[]

  @@index([userId])
}

model Lead {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  buyPrice     Float
  buyCurrency  Currency @default(EUR)
  sellPrice    Float
  sellCurrency Currency @default(EUR)
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([brandId])
  @@index([clientId])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  amount          Float
  currency        Currency      @default(EUR)
  status          InvoiceStatus @default(PENDING)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  stripeInvoiceId String?
  archived        Boolean       @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Parties de la facture. Mr.Lead = type "MRLEAD" (interne, pas de FK).
  // Le débiteur doit, le créditeur reçoit. Chaque côté ∈ CLIENT | BRAND | APPORTEUR | MRLEAD.
  debtorType   String @default("CLIENT")
  creditorType String @default("MRLEAD")

  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id])
  apporteurId String?
  apporteur   Apporteur? @relation(fields: [apporteurId], references: [id])

  payments Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([brandId])
  @@index([apporteurId])
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  currency        Currency @default(EUR)
  method          String?
  stripePaymentId String?
  paidAt          DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Commission {
  id       String    @id @default(cuid())
  amount   Float
  currency Currency  @default(EUR)
  status   String    @default("PENDING")
  paidAt   DateTime?

  apporteurId String
  apporteur   Apporteur @relation(fields: [apporteurId], references: [id])

  @@index([apporteurId])
}

// --- Marketplace de leads ---

// Un thème = une catégorie de leads vendue aux brands (ex: "Voyage cacher").
// Prix de base par lead + paliers de remise quantité (PriceTier).
model Theme {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  pricePerLead Float
  currency     Currency @default(EUR)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tiers     PriceTier[]
  prospects Prospect[]

  @@index([userId])
}

// Palier de remise : à partir de `minQty` leads achetés, le prix unitaire passe à `pricePerLead`.
model PriceTier {
  id           String @id @default(cuid())
  minQty       Int
  pricePerLead Float

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

// Un prospect du stock : contact + champ libre "détails", rattaché à un thème.
// Exclusif : une fois vendu (status SOLD), il est attribué à une brand acheteuse et sort du stock.
model Prospect {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  details   String?        @db.Text
  source    String?
  status    ProspectStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  soldAt    DateTime?

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  buyerBrandId String?
  buyerBrand   Brand?  @relation("BrandPurchasedProspects", fields: [buyerBrandId], references: [id])

  @@index([themeId])
  @@index([userId])
  @@index([buyerBrandId])
  @@index([status])
}
