generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Currency {
  EUR
  ILS
  USD
}

enum InvoiceStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum CommissionType {
  PERCENT
  FIXED
}

model User {
  id         String       @id  // ID Supabase Auth
  email      String       @unique
  name       String?
  role       Role         @default(USER)
  createdAt  DateTime     @default(now())
  archived   Boolean      @default(false)

  brands     Brand[]
  clients    Client[]
  apporteurs Apporteur[]
  leads      Lead[]
  invoices   Invoice[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  leads     Lead[]
  invoices  Invoice[]
}

model Client {
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  stripeCustomerId  String?
  archived          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  userId            String
  user              User      @relation(fields: [userId], references: [id])

  apporteurId       String?
  apporteur         Apporteur? @relation(fields: [apporteurId], references: [id])

  leads             Lead[]
  invoices          Invoice[]
}

model Apporteur {
  id              String         @id @default(cuid())
  name            String
  email           String?
  phone           String?
  commissionType  CommissionType @default(PERCENT)
  commissionValue Float          @default(10)
  archived        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  userId          String
  user            User           @relation(fields: [userId], references: [id])

  clients         Client[]
  commissions     Commission[]
}

model Lead {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  buyPrice     Float
  buyCurrency  Currency @default(EUR)
  sellPrice    Float
  sellCurrency Currency @default(EUR)
  label        String?

  userId       String
  user         User     @relation(fields: [userId], references: [id])

  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id])

  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
}

model Invoice {
  id                String         @id @default(cuid())
  number            String         @unique
  amount            Float
  currency          Currency       @default(EUR)
  status            InvoiceStatus  @default(PENDING)
  issueDate         DateTime       @default(now())
  dueDate           DateTime
  paidAt            DateTime?
  stripeInvoiceId   String?
  archived          Boolean        @default(false)

  userId            String
  user              User           @relation(fields: [userId], references: [id])

  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id])
  brandId           String?
  brand             Brand?         @relation(fields: [brandId], references: [id])

  payments          Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  currency        Currency @default(EUR)
  method          String?
  stripePaymentId String?
  paidAt          DateTime @default(now())

  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}

model Commission {
  id           String    @id @default(cuid())
  amount       Float
  currency     Currency  @default(EUR)
  status       String    @default("PENDING")
  paidAt       DateTime?

  apporteurId  String
  apporteur    Apporteur @relation(fields: [apporteurId], references: [id])
}